{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "eoding-product-register": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${PLUGIN_ROOT}/scripts/plugin-start.mjs"
      ],
      "cwd": "${PLUGIN_ROOT}",
      "env": {
        "EODING_DATA_DIR": "${PLUGIN_DATA}",
        "EODING_INPUT_DIR": "${PLUGIN_DATA}/input"
      }
    }
  }
}
